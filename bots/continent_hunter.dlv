%
%  CONTINENT HUNTER  -  strategist
%  Plays for the continent bonuses. It pushes into whichever continent it
%  already owns the most of (closest to a full set) and reinforces the
%  border that opens onto its best continent. Only takes favourable fights.
%

owned(T) :- owner(T, I), my_id(I).
enemy(T) :- territory(T), not owned(T).
border(T) :- owned(T), neighbor(T, E), enemy(E).
has_border :- border(T).

% how many territories of each continent we already hold.
cont_share(C, S) :- in_continent(_, C), S = #count{T : in_continent(T, C), owned(T)}.

% ======================= FORTIFY =======================
% reinforce the border that opens onto the continent we own the most of.
pscore(T, V) :- border(T),
                V = #max{S : neighbor(T, E), enemy(E), in_continent(E, C), cont_share(C, S)}.
best(M)   :- M = #max{V : pscore(_, V)}.
cand(T)   :- pscore(T, V), best(V).
target(T) :- T = #min{X : cand(X)}.
target(T) :- not has_border, T = #min{X : owned(X)}.
fortify(T, A) :- phase(fortify), to_fortify(A), target(T).

% ======================= CHOOSE ========================
can_attack(MT, ET) :- owned(MT), enemy(ET), neighbor(MT, ET),
                      armies_present(MT, MA), armies_present(ET, EA),
                      MA >= 2, MA >= EA.
attackable :- can_attack(_, _).

{ attack(MT, ET) : can_attack(MT, ET) } <= 1 :- phase(choose).
{ pass } :- phase(choose).

:- #count{X, Y : attack(X, Y); X, Y, Z : move(X, Y, Z); A : pass, A = 1} != 1, phase(choose).
:- phase(choose), attackable, pass.
:- phase(choose), not attackable, not pass.

% primary: push into the continent we are closest to completing.
:~ attack(MT, ET), in_continent(ET, C), cont_share(C, S). [-S@2, MT, ET]
% secondary: among those, take the safer fight.
:~ attack(MT, ET), armies_present(MT, MA), armies_present(ET, EA), W = EA - MA. [W@1, MT, ET]

% ======================= CONQUER =======================
% (unhandled -> engine default.)
