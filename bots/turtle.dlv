%
%  TURTLE  -  defensive
%  Hoards armies on its most threatened border and only strikes when it has
%  an overwhelming edge (at least 3 more armies than the defender). Otherwise
%  it sits tight and lets enemies break themselves on its walls.
%

owned(T) :- owner(T, I), my_id(I).
enemy(T) :- territory(T), not owned(T).
border(T) :- owned(T), neighbor(T, E), enemy(E).
has_border :- border(T).

% ======================= FORTIFY =======================
% wall up the most pressured border.
pscore(T, V) :- border(T), V = #sum{A, E : neighbor(T, E), enemy(E), armies_present(E, A)}.
best(M)      :- M = #max{V : pscore(_, V)}.
cand(T)      :- pscore(T, V), best(V).
target(T)    :- T = #min{X : cand(X)}.
target(T)    :- not has_border, T = #min{X : owned(X)}.
fortify(T, A) :- phase(fortify), to_fortify(A), target(T).

% ======================= CHOOSE ========================
% only "free" attacks: we need at least 3 more armies than the defender.
can_attack(MT, ET) :- owned(MT), enemy(ET), neighbor(MT, ET),
                      armies_present(MT, MA), armies_present(ET, EA),
                      MA >= 2, MA >= EA + 3.
attackable :- can_attack(_, _).

{ attack(MT, ET) : can_attack(MT, ET) } <= 1 :- phase(choose).
{ pass } :- phase(choose).

:- #count{X, Y : attack(X, Y); X, Y, Z : move(X, Y, Z); A : pass, A = 1} != 1, phase(choose).
:- phase(choose), attackable, pass.
:- phase(choose), not attackable, not pass.

% among safe attacks, take the safest (largest advantage).
:~ attack(MT, ET), armies_present(MT, MA), armies_present(ET, EA), W = EA - MA. [W@1, MT, ET]

% ======================= CONQUER =======================
% (unhandled -> engine default.)
